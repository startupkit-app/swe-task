{
  "request": {
    "method": "POST",
    "urlPathPattern": "/webhook/.*"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "received": true
    },
    "transformers": ["response-template"],
    "fixedDelayMilliseconds": 100
  }
}
